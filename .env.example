# Askesis configuration. Copy this file to .env at the repository root:
#   cp .env.example .env
# The API, the web app and the database scripts all read that one file.
# Restart `pnpm dev` after changing it.

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres connection string. The default matches the database `pnpm db:up`
# starts in Docker (docker/postgres/Dockerfile).
DATABASE_URL=postgres://askesis:askesis@localhost:5432/askesis

# Signs sessions; at least 32 random characters. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public origin of the web app (auth cookies are issued for it)
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=4000
# Server-only: where the web app's server functions reach the API
API_URL=http://127.0.0.1:4000

# ── Optional ──────────────────────────────────────────────────────────────────

# Web Push for daily reminders (reminders are off until both keys are set).
# Generate a key pair with: pnpm --filter @askesis/api vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach if something goes wrong.
VAPID_SUBJECT=mailto:you@example.com

# Public origin used for canonical URLs, Open Graph tags and the sitemap.
# Exposed to the browser (VITE_ prefix). Set it to your real domain in production.
VITE_SITE_URL=http://localhost:3000

# Product analytics (PostHog), loaded only for visitors who accept all cookies.
# Leave both empty to turn analytics off. The host is PostHog's (for example
# https://eu.i.posthog.com) or a reverse proxy to it on your own domain.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=

# Public links shown in the top bar and the home page's support section.
VITE_GITHUB_URL=https://github.com/Romflz/askesis-project
VITE_PATREON_URL=https://www.patreon.com/c/askesis_project
# Shown on the contact page.
VITE_CONTACT_EMAIL=romflz@proton.me
