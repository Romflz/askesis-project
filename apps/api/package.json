{
  "name": "@askesis/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p .",
    "supporter": "node --env-file-if-exists=../../.env scripts/set-supporter.ts",
    "vapid": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\\nVAPID_PRIVATE_KEY='+k.privateKey)\""
  },
  "dependencies": {
    "@askesis/contracts": "workspace:*",
    "@askesis/core": "workspace:*",
    "@askesis/db": "workspace:*",
    "better-auth": "^1.7.7",
    "fastify": "^5.12.7",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4"
  }
}
